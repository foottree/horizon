{%- doc -%}
  A mega menu panel matched to one top-level header menu item by title.

  Rendered by blocks/_header-menu.liquid as a *static* block (content_for 'block' only renders
  statics — a plain `for panel in block.blocks` loop cannot read a nested theme block's own
  `settings`, they resolve blank outside the block's own render, and content_for 'block' only
  accepts a literal id, not a variable, so a merchant-added, freely-matched block can't be
  looked up by id either). _header-menu.liquid instead declares a handful of static panel
  slots (`mega-menu-panel-1..4`) and, for every top-level link, tries each slot in turn,
  passing the `link` being tested; this block only renders real markup when its own
  `menu_item` setting matches that link's title (case-insensitive), otherwise it renders
  nothing so the parent falls through to its plain dropdown/mega style.

  @param {object} link - The top-level menu link being tried against this panel.

  @example
  {% content_for 'block', type: '_mega-menu-panel', id: 'mega-menu-panel-1', link: link %}
{%- enddoc -%}

{% liquid
  assign show_panel = false
  if block.settings.menu_item != blank and link.title != blank
    assign panel_menu_item_key = block.settings.menu_item | strip | downcase
    assign link_title_key = link.title | strip | downcase
    if panel_menu_item_key == link_title_key
      assign show_panel = true
    endif
  endif
%}
{% if show_panel %}
  {% case block.settings.style %}
    {% when 'tabbed' %}
      {% render 'mega-menu-tabbed', link: link, panel: block %}
    {% when 'grid' %}
      {% capture promo_tiles %}
        {% content_for 'blocks' %}
      {% endcapture %}
      {% render 'mega-menu-grid', link: link, panel: block, promo_tiles: promo_tiles %}
  {% endcase %}
{% endif %}

{% schema %}
{
  "name": "t:names.mega_menu_panel",
  "tag": null,
  "blocks": [
    {
      "type": "_mega-menu-promo"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "menu_item",
      "label": "t:settings.menu_item_title",
      "info": "t:info.mega_menu_panel_menu_item"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "tabbed",
          "label": "t:options.tabbed"
        },
        {
          "value": "grid",
          "label": "t:options.grid"
        }
      ],
      "default": "tabbed"
    },
    {
      "type": "header",
      "content": "t:content.grid_layout"
    },
    {
      "type": "paragraph",
      "content": "t:content.grid_layout_paragraph"
    },
    {
      "type": "link_list",
      "id": "group_1_menu",
      "label": "t:settings.group_1_menu",
      "visible_if": "{{ block.settings.style == 'grid' }}"
    },
    {
      "type": "link_list",
      "id": "group_2_menu",
      "label": "t:settings.group_2_menu",
      "visible_if": "{{ block.settings.style == 'grid' }}"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "t:settings.shop_all_label",
      "default": "Shop all",
      "visible_if": "{{ block.settings.style == 'grid' }}"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "t:settings.shop_all_url",
      "visible_if": "{{ block.settings.style == 'grid' }}"
    }
  ]
}
{% endschema %}
