{%- doc -%}
  A promo tile nested inside a `_mega-menu-panel` (grid style, right column). No image ->
  the tile keeps its background colour placeholder (settings.color_palette.color5).

  Rendered by its parent panel's own `{% content_for 'blocks' %}` (a block's direct children
  render this way, unlike a grandchild read from two levels up — see the note in
  _mega-menu-panel.liquid), so `block.settings` here is the tile's own, fully resolved.

  Wrapped in a `<div class="ft-grid__promo-card">` so the SAME markup doubles as one card of the
  mobile drawer's promo strip (snippets/mega-menu-drawer-promos.liquid gives it the stock
  `...featured-content-list-item--card` classes too) without needing per-tile params:
  `content_for 'blocks'` (unlike `content_for 'block'` on a single static block) takes no extra
  arguments, so this file can't be told "drawer: true" and has no way to know which context it's
  in. On desktop the wrapper is made to disappear with `display: contents` (assets/custom.css,
  "Mobile drawer: thumbnails & promo slider" block), so `.ft-grid__right` sees the same flat run
  of `.ft-grid__promo` anchors as before. A `<div>`, not a semantically-neater `<li>` (matching
  the drawer strip's own `<li>`-less children elsewhere would be tidier): while tracking down a
  reproducible bug where this tile's markup landed as a stray, always-visible element outside
  its hover-gated wrapper (see blocks/_mega-menu-panel.liquid's own doc comment for the actual
  fix), an `<li>` wrapper was one of two things changed at the same time as the bug disappeared,
  so it stays a `<div>` out of caution even though `<overflow-list>`
  (snippets/overflow-list.liquid, the "More" overflow) only reads its own direct light-DOM
  children and shouldn't itself care about a `<li>` several levels deeper than that.

  @example
  Rendered automatically, in block order, by the matched `_mega-menu-panel`'s
  `{% content_for 'blocks' %}` — never called directly.
{%- enddoc -%}

<div
  class="ft-grid__promo-card menu-drawer__featured-content-list-item menu-drawer__featured-content-list-item--card"
  {{ block.shopify_attributes }}
>
  <a
    href="{{ block.settings.url | default: '#' }}"
    class="ft-grid__promo"
    style="--promo-aspect-ratio: {{ block.settings.aspect_ratio | default: '3 / 2' }};"
  >
    {% if block.settings.image %}
      {{
        block.settings.image
        | image_url: width: 630
        | image_tag:
          loading: 'lazy',
          widths: '315, 630',
          sizes: '(min-width: 990px) 315px, 25vw',
          class: 'ft-grid__promo-image'
      }}
    {% endif %}
    <span
      class="ft-grid__promo-overlay"
      aria-hidden="true"
    ></span>
    <span class="ft-grid__promo-content">
      {% if block.settings.caption != blank %}
        <span class="ft-grid__promo-caption">{{- block.settings.caption -}}</span>
      {% endif %}
      {% if block.settings.button_label != blank %}
        <span class="ft-grid__promo-btn">{{- block.settings.button_label -}}</span>
      {% endif %}
    </span>
  </a>
</div>

{% schema %}
{
  "name": "t:names.mega_menu_promo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:settings.caption"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "3 / 2", "label": "t:options.landscape" },
        { "value": "1 / 1", "label": "t:options.square" },
        { "value": "4 / 5", "label": "t:options.portrait" }
      ],
      "default": "3 / 2"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:settings.link"
    }
  ]
}
{% endschema %}
