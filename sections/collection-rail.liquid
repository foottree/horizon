{% comment %}
  "Shop by Collection" rail (homepage section 02 in the client's Figma). Groups its
  `_collection-tile` blocks into panels of four (big / small-a / small-b / tall, in that visual
  order - a trailing partial panel just renders with whatever tiles are left) and renders two
  Horizon slideshows: a desktop one whose slides are whole panels, and a mobile one whose slides
  are the individual tiles (Horizon's own "carousel on mobile" pattern, see
  snippets/resource-list-carousel.liquid). Each tile is rendered through snippets/collection-tile
  .liquid directly from this loop over section.blocks (not content_for 'block'/'blocks' - a
  dynamic per-instance id isn't a valid content_for argument, and content_for 'blocks' can't be
  told to group four blocks into one slide). Each tile's markup is captured once and reused in
  both slideshows - only one is visible at a time (hidden--mobile / hidden--desktop) - the same
  technique snippets/resource-list.liquid uses for its own mobile carousel fallback.
{% endcomment %}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

{%- liquid
  assign desktop_slides = ''
  assign mobile_slides = ''
  assign panel_buffer = ''
  assign panel_index = 0
  assign tile_count = section.blocks.size
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign slot_index = forloop.index0 | modulo: 4
    case slot_index
      when 0
        assign tile_slot = 'big'
      when 1
        assign tile_slot = 'small-a'
      when 2
        assign tile_slot = 'small-b'
      when 3
        assign tile_slot = 'tall'
    endcase
  -%}

  {%- capture tile_html -%}
    {%- render 'collection-tile',
      collection: block.settings.collection,
      label: block.settings.label,
      image: block.settings.image,
      tile_slot: tile_slot,
      block_attributes: block.shopify_attributes
    -%}
  {%- endcapture -%}

  {%- assign panel_buffer = panel_buffer | append: tile_html -%}

  {%- capture mobile_slide -%}
    {%- render 'slideshow-slide', index: forloop.index0, children: tile_html, class: 'collection-rail__mobile-slide' -%}
  {%- endcapture -%}
  {%- assign mobile_slides = mobile_slides | append: mobile_slide -%}

  {%- if slot_index == 3 or forloop.last -%}
    {%- capture panel_html -%}
      <div class="collection-rail__panel">{{ panel_buffer }}</div>
    {%- endcapture -%}
    {%- capture desktop_slide -%}
      {%- render 'slideshow-slide', index: panel_index, children: panel_html, class: 'collection-rail__panel-slide' -%}
    {%- endcapture -%}
    {%- assign desktop_slides = desktop_slides | append: desktop_slide -%}
    {%- assign panel_index = panel_index | plus: 1 -%}
    {%- assign panel_buffer = '' -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  assign mobile_card_size = section.settings.mobile_card_size | default: 85
  assign desktop_style = '--slideshow-gap: 40px;'
  assign mobile_style = '--slideshow-gap: 16px; --slide-width: ' | append: mobile_card_size | append: '%;'
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    collection-rail
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --collection-rail-heading-color: {{ settings.color_palette.color1 }};
    --collection-rail-accent-color: {{ settings.color_palette.color4 }};
    --collection-rail-track-color: {{ settings.color_palette.color3 }};
  "
  data-testid="collection-rail"
>
  <div class="collection-rail__header">
    <h2
      class="collection-rail__heading h2"
      style="color: var(--collection-rail-heading-color);"
    >{{ section.settings.heading }}</h2>
    {%- if section.settings.link != blank -%}
      <a
        href="{{ section.settings.link }}"
        class="collection-rail__shop-all"
      >
        <span>{{ section.settings.link_label }}</span>
        <span
          class="collection-rail__shop-all-arrow"
          aria-hidden="true"
        >
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </a>
    {%- endif -%}
  </div>

  <div class="collection-rail__desktop hidden--mobile">
    {%- capture desktop_controls -%}
      {%- render 'slideshow-controls',
        style: 'progress',
        item_count: panel_index,
        show_arrows: false,
        arrows_on_media: false,
        controls_on_media: false,
        pagination_position: 'center',
        class: 'collection-rail__controls'
      -%}
    {%- endcapture -%}
    {%- render 'slideshow',
      ref: 'collectionRailDesktop',
      class: 'collection-rail__slideshow',
      style: desktop_style,
      slides: desktop_slides,
      show_arrows: false,
      auto_hide_controls: false,
      infinite: false,
      initial_slide: 0,
      slide_count: panel_index,
      controls: desktop_controls
    -%}
  </div>

  <div
    class="collection-rail__mobile hidden--desktop force-full-width"
    style="--gutter-slide-width: var(--util-page-margin-offset);"
  >
    {%- capture mobile_controls -%}
      {%- render 'slideshow-controls',
        style: 'progress',
        item_count: tile_count,
        show_arrows: false,
        arrows_on_media: false,
        controls_on_media: false,
        pagination_position: 'center',
        class: 'collection-rail__controls'
      -%}
    {%- endcapture -%}
    {%- render 'slideshow',
      ref: 'collectionRailMobile',
      class: 'collection-rail__slideshow collection-rail__slideshow--mobile',
      style: mobile_style,
      slides: mobile_slides,
      show_arrows: false,
      auto_hide_controls: false,
      infinite: false,
      initial_slide: 0,
      slide_count: tile_count,
      slideshow_gutters: 'start end',
      controls: mobile_controls
    -%}
  </div>
</div>

{% stylesheet %}
  .collection-rail__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-block-end: 32px;
  }

  .collection-rail__heading {
    margin: 0;
    color: var(--collection-rail-heading-color, currentcolor);
  }

  .collection-rail__shop-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--collection-rail-accent-color, currentcolor);
    text-decoration: none;
    white-space: nowrap;
  }

  .collection-rail__shop-all:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  .collection-rail__shop-all-arrow {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* The theme's h2 preset (settings.type_size_h2) is a fixed 40px below the fluid-scaling
     cutoff, so it carries no mobile size of its own here - pin the Figma's 32px explicitly,
     with enough specificity to beat the global `.h2.h2` preset rule (0,2,0). */
  @media screen and (max-width: 749px) {
    .collection-rail .collection-rail__header .collection-rail__heading {
      font-size: 2rem;
    }
  }

  .collection-rail__shop-all-arrow svg {
    width: 100%;
    height: 100%;
  }

  /* Desktop rail: each slide is a whole panel (four tiles), no peeking - the slide
     defaults to 100% width (see slideshow-slide's --slide-width fallback). */
  .collection-rail__panel-slide {
    scroll-snap-align: start;
  }

  .collection-rail__panel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    gap: 24px;
    grid-template-areas:
      'big big tall tall'
      'smalla smallb tall tall';
  }

  .collection-rail__panel .collection-rail__tile--big {
    grid-area: big;
  }

  .collection-rail__panel .collection-rail__tile--small-a {
    grid-area: smalla;
  }

  .collection-rail__panel .collection-rail__tile--small-b {
    grid-area: smallb;
  }

  .collection-rail__panel .collection-rail__tile--tall {
    grid-area: tall;
  }

  /* Mobile rail: every tile is its own slide at a uniform 3:4 ratio, regardless of its
     desktop slot. */
  .collection-rail__mobile-slide {
    scroll-snap-align: start;
  }

  .collection-rail__mobile .collection-rail__tile .collection-rail__tile-image {
    aspect-ratio: 3 / 4;
  }

  /* Progress bar: 4px track spanning the rail's own width, no arrows. */
  .collection-rail .slideshow-controls__progress {
    margin-top: 32px;
    padding-inline: 0;
    gap: 16px;
  }

  .collection-rail .slideshow-controls__progress-track {
    height: 4px;
    background: var(--collection-rail-track-color, var(--color-border));
  }

  .collection-rail .slideshow-controls__progress-bar {
    background: var(--collection-rail-accent-color, var(--color-foreground));
  }

  .collection-rail .slideshow-controls__progress-arrows {
    display: none;
  }

  .collection-rail__mobile.force-full-width .slideshow-controls__progress {
    padding-inline: var(--util-page-margin-offset, var(--page-margin, 16px));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_rail",
  "class": "ui-test-collection-rail",
  "blocks": [
    {
      "type": "collection_tile",
      "name": "t:names.collection_tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.shop_by_collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "t:text_defaults.shop_all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "range",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_card_size",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_padding",
      "label": "Custom Mobile Padding",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile-padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "mobile-padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "mobile-padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "mobile-padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_rail",
      "category": "t:categories.collections",
      "settings": {
        "link": "shopify://collections/all"
      },
      "blocks": {
        "tile_1": {
          "type": "collection_tile",
          "name": "t:names.collection_tile"
        },
        "tile_2": {
          "type": "collection_tile",
          "name": "t:names.collection_tile"
        },
        "tile_3": {
          "type": "collection_tile",
          "name": "t:names.collection_tile"
        },
        "tile_4": {
          "type": "collection_tile",
          "name": "t:names.collection_tile"
        }
      },
      "block_order": [
        "tile_1",
        "tile_2",
        "tile_3",
        "tile_4"
      ]
    }
  ]
}
{% endschema %}
