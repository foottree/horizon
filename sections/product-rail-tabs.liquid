{% comment %}
  "Bestsellers" rail (homepage section 03 in the client's Figma): a heading/description/link
  header exactly like sections/collection-rail.liquid, then a tablist that swaps which
  product carousel is showing below it. Each tab owns its own collection + product count and
  renders its own pair of desktop/mobile slideshows (again mirroring collection-rail's
  dual-slideshow pattern) built from Horizon's own `_product-card` static block - one
  `content_for 'block'` call per product, captured once and reused in both the desktop and
  mobile slide so the block is only instantiated once per product (the same reason
  collection-rail captures its tile markup instead of calling content_for twice).

  Tabs are 4 fixed setting groups (tab_1_label/collection/max_products .. tab_4_*), NOT a
  repeatable block type, even though the Figma calls for exactly two (Women/Men) and a block
  list reads more naturally: Shopify does not allow a section to mix its own static theme
  block (the `_product-card` card above, referenced via content_for) with ANY block that is
  merchant-addable, whether declared inline (section-local - theme-check's ValidLocalBlocks
  rejects it outright: "Sections cannot use static theme blocks together with locally scoped
  blocks") or as its own file (a real theme block - the push itself is then rejected
  server-side: "Theme blocks and section-defined blocks can not be used together"; and even
  when only ONE of the two categories is used, a parent section cannot read a theme block's
  own settings at all - `block.type` reports the literal string "@theme" and `block.settings`
  is empty, a currently-unresolved Shopify platform limitation, confirmed on the Shopify
  Community forum ("How to access Theme Blocks settings in Parent Section?"), not something
  fixable from this file. A tab with a blank label is skipped, so 2-4 tabs both work.

  The desktop rail is a fixed 320px-card row (not the kit's fluid --column-count formula):
  the wrapping `<product-rail-tabs>` element is `force-full-width` (edge-to-edge under the
  section's own grid, the same trick collection-rail uses for its mobile carousel) and the
  tablist/rail each re-establish the content column with `--util-page-margin-offset`. The
  desktop slideshow only gutters its *start* edge (`slideshow_gutters: 'start'`) so the row
  bleeds past the content column into the right-hand margin/viewport edge and a fifth card
  peeks, per the Figma spec. The mobile slideshow guttres both edges as usual.

  Swatch box size/radius/gap and the selected-swatch border are overridden here (scoped
  under .product-rail-tabs) rather than through global swatch settings - see swatch-styles
  .liquid and blocks/swatches.liquid for the class names/custom properties being targeted.
{% endcomment %}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

{%- liquid
  assign heading_color = settings.color_palette.color1
  assign accent_color = settings.color_palette.color4
  assign track_color = settings.color_palette.color3
  assign ink_soft_color = settings.color_palette.color8
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    product-rail-tabs
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --product-rail-tabs-heading-color: {{ heading_color }};
    --product-rail-tabs-accent-color: {{ accent_color }};
    --product-rail-tabs-track-color: {{ track_color }};
    --product-rail-tabs-ink-soft: {{ ink_soft_color }};
  "
  data-testid="product-rail-tabs"
>
  {%- if section.settings.heading != blank or section.settings.description != blank or section.settings.link != blank -%}
    <div class="product-rail-tabs__header">
      <div class="product-rail-tabs__header-text">
        {%- if section.settings.heading != blank -%}
          <h2
            class="product-rail-tabs__heading h2"
            style="color: var(--product-rail-tabs-heading-color);"
          >{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="product-rail-tabs__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.link != blank -%}
        <a
          href="{{ section.settings.link }}"
          class="product-rail-tabs__link"
        >
          <span>{{ section.settings.link_label }}</span>
          <span
            class="product-rail-tabs__link-arrow"
            aria-hidden="true"
          >
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <product-rail-tabs
    class="product-rail-tabs__interactive force-full-width{% if section.settings.show_arrows %} product-rail-tabs__interactive--arrows{% endif %}"
  >
    <div
      class="product-rail-tabs__tablist-wrap"
      style="padding-inline: var(--util-page-margin-offset);"
    >
      <div
        role="tablist"
        {% if section.settings.heading != blank %}
          aria-label="{{ section.settings.heading | escape }}"
        {% endif %}
        class="product-rail-tabs__tablist product-rail-tabs__tablist--{{ section.settings.tabs_style }}"
      >
        {%- liquid
          assign visible_tab_index = -1
        -%}
        {%- for i in (1..4) -%}
          {%- liquid
            assign label_key = 'tab_' | append: i | append: '_label'
            assign tab_label = section.settings[label_key]
            if tab_label == blank
              continue
            endif
            assign visible_tab_index = visible_tab_index | plus: 1
          -%}
          <button
            type="button"
            role="tab"
            id="product-rail-tabs-tab-{{ section.id }}-{{ visible_tab_index }}"
            aria-selected="{% if visible_tab_index == 0 %}true{% else %}false{% endif %}"
            aria-controls="product-rail-tabs-panel-{{ section.id }}-{{ visible_tab_index }}"
            tabindex="{% if visible_tab_index == 0 %}0{% else %}-1{% endif %}"
            class="product-rail-tabs__tab"
            ref="tabs[]"
            on:click="/selectTab/{{ visible_tab_index }}"
            on:keydown="/handleKeydown"
          >
            {{- tab_label -}}
          </button>
          <span
            class="product-rail-tabs__tab-divider"
            aria-hidden="true"
          ></span>
        {%- endfor -%}
      </div>
    </div>

    {%- assign visible_panel_index = -1 -%}
    {%- for i in (1..4) -%}
      {%- liquid
        assign label_key = 'tab_' | append: i | append: '_label'
        assign tab_label = section.settings[label_key]
        if tab_label == blank
          continue
        endif
        assign visible_panel_index = visible_panel_index | plus: 1

        assign collection_key = 'tab_' | append: i | append: '_collection'
        assign max_products_key = 'tab_' | append: i | append: '_max_products'
        assign tab_collection = section.settings[collection_key]
        assign max_items = section.settings[max_products_key]

        assign desktop_slides = ''
        assign mobile_slides = ''
        assign card_count = 0

        if tab_collection != blank and tab_collection.products.size > 0
          for product in tab_collection.products limit: max_items
            capture card_html
              content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product, product_view_context: 'collection'
            endcapture
            capture desktop_slide
              render 'slideshow-slide', index: forloop.index0, children: card_html, class: 'product-rail-tabs__slide'
            endcapture
            assign desktop_slides = desktop_slides | append: desktop_slide
            capture mobile_slide
              render 'slideshow-slide', index: forloop.index0, children: card_html, class: 'product-rail-tabs__slide product-rail-tabs__slide--mobile'
            endcapture
            assign mobile_slides = mobile_slides | append: mobile_slide
            assign card_count = forloop.index
          endfor
        else
          for i in (1..4)
            assign placeholder_index = i | minus: 1
            capture card_html
              content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null
            endcapture
            capture desktop_slide
              render 'slideshow-slide', index: placeholder_index, children: card_html, class: 'product-rail-tabs__slide'
            endcapture
            assign desktop_slides = desktop_slides | append: desktop_slide
            capture mobile_slide
              render 'slideshow-slide', index: placeholder_index, children: card_html, class: 'product-rail-tabs__slide product-rail-tabs__slide--mobile'
            endcapture
            assign mobile_slides = mobile_slides | append: mobile_slide
            assign card_count = i
          endfor
        endif
      -%}

      <div
        role="tabpanel"
        id="product-rail-tabs-panel-{{ section.id }}-{{ visible_panel_index }}"
        aria-labelledby="product-rail-tabs-tab-{{ section.id }}-{{ visible_panel_index }}"
        class="product-rail-tabs__panel"
        ref="panels[]"
        {% unless visible_panel_index == 0 %}
          hidden
        {% endunless %}
      >
        <div
          class="product-rail-tabs__rail-desktop hidden--mobile force-full-width"
          style="--gutter-slide-width: var(--util-page-margin-offset);"
        >
          {%- capture desktop_controls -%}
            {%- render 'slideshow-controls',
              style: 'progress',
              item_count: card_count,
              show_arrows: section.settings.show_arrows,
              arrows_on_media: false,
              controls_on_media: false,
              pagination_position: 'center',
              class: 'product-rail-tabs__controls'
            -%}
          {%- endcapture -%}
          {%- render 'slideshow',
            class: 'product-rail-tabs__rail-slideshow',
            style: '--slideshow-gap: 24px;',
            slides: desktop_slides,
            show_arrows: false,
            auto_hide_controls: false,
            infinite: false,
            initial_slide: 0,
            slide_count: card_count,
            slideshow_gutters: 'start',
            controls: desktop_controls
          -%}
        </div>

        <div
          class="product-rail-tabs__rail-mobile hidden--desktop force-full-width"
          style="--gutter-slide-width: var(--util-page-margin-offset);"
        >
          {%- capture mobile_controls -%}
            {%- render 'slideshow-controls',
              style: 'progress',
              item_count: card_count,
              show_arrows: false,
              arrows_on_media: false,
              controls_on_media: false,
              pagination_position: 'center',
              class: 'product-rail-tabs__controls'
            -%}
          {%- endcapture -%}
          {%- assign mobile_slide_width = section.settings.mobile_card_size | append: 'cqw;' -%}
          {%- capture mobile_slideshow_style -%}--slideshow-gap: 16px; --slide-width: {{ mobile_slide_width }}{%- endcapture -%}
          {%- render 'slideshow',
            class: 'product-rail-tabs__rail-slideshow product-rail-tabs__rail-slideshow--mobile',
            style: mobile_slideshow_style,
            slides: mobile_slides,
            show_arrows: false,
            auto_hide_controls: false,
            infinite: false,
            initial_slide: 0,
            slide_count: card_count,
            slideshow_gutters: 'start end',
            controls: mobile_controls
          -%}
        </div>
      </div>
    {%- endfor -%}
  </product-rail-tabs>
</div>

<script
  type="module"
  src="{{ 'product-rail-tabs.js' | asset_url }}"
></script>

{% stylesheet %}
  .product-rail-tabs__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-block-end: 40px;
  }

  .product-rail-tabs__header-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .product-rail-tabs__heading {
    margin: 0;
    color: var(--product-rail-tabs-heading-color, currentcolor);
  }

  .product-rail-tabs__description {
    max-width: 700px;
    font-family: var(--font-body--family);
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--product-rail-tabs-ink-soft, currentcolor);
  }

  .product-rail-tabs__description p {
    margin: 0;
  }

  .product-rail-tabs__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--product-rail-tabs-accent-color, currentcolor);
    text-decoration: none;
    white-space: nowrap;
  }

  .product-rail-tabs__link:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  .product-rail-tabs__link-arrow {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .product-rail-tabs__link-arrow svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .product-rail-tabs .product-rail-tabs__header .product-rail-tabs__heading {
      font-size: 2rem;
    }
  }

  /* Tablist */
  .product-rail-tabs__tablist-wrap {
    margin-block-end: 40px;
  }

  .product-rail-tabs__tablist {
    width: 100%;
  }

  .product-rail-tabs__tab {
    appearance: none;
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
  }

  /* Segmented (default) style: a single pill, tabs share its width equally */
  .product-rail-tabs__tablist--segmented {
    display: flex;
    align-items: stretch;
    height: 44px;
    background: var(--color-background, #fff);
    border: 1.5px solid var(--product-rail-tabs-track-color, #e0dcd2);
    border-radius: 999px;
    overflow: hidden;
  }

  .product-rail-tabs__tablist--segmented .product-rail-tabs__tab {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 12px;
    background: transparent;
    border: none;
    border-radius: 999px;
    color: var(--product-rail-tabs-ink-soft, #5c5a52);
    font-size: 1rem;
    line-height: 1.5;
    text-align: center;
    cursor: pointer;
    transition: background-color 180ms var(--animation-easing, ease), color 180ms var(--animation-easing, ease);
  }

  .product-rail-tabs__tablist--segmented .product-rail-tabs__tab[aria-selected='true'] {
    background: var(--product-rail-tabs-accent-color, #4a6a1d);
    color: var(--color-background, #fff);
  }

  .product-rail-tabs__tablist--segmented .product-rail-tabs__tab-divider {
    align-self: center;
    width: 1px;
    height: 24px;
    background: var(--product-rail-tabs-track-color, #e0dcd2);
  }

  /* A divider renders after every tab (including the last) so the Liquid loop doesn't need
     to look ahead for "is this the last VISIBLE tab" - hide the trailing one and any next to
     an active tab here instead. */
  .product-rail-tabs__tablist--segmented .product-rail-tabs__tab-divider:last-child,
  .product-rail-tabs__tablist--segmented .product-rail-tabs__tab[aria-selected='true'] + .product-rail-tabs__tab-divider,
  .product-rail-tabs__tablist--segmented
    .product-rail-tabs__tab-divider:has(+ .product-rail-tabs__tab[aria-selected='true']) {
    visibility: hidden;
  }

  /* Text style: plain labels with an underline beneath the active one */
  .product-rail-tabs__tablist--text {
    display: flex;
    gap: 36px;
  }

  .product-rail-tabs__tablist--text .product-rail-tabs__tab-divider {
    display: none;
  }

  .product-rail-tabs__tablist--text .product-rail-tabs__tab {
    position: relative;
    padding: 0 0 12px;
    background: none;
    border: none;
    color: var(--product-rail-tabs-ink-soft, #5c5a52);
    font-size: 1.25rem;
    line-height: 1.4;
    cursor: pointer;
  }

  .product-rail-tabs__tablist--text .product-rail-tabs__tab::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 3px;
    background: var(--product-rail-tabs-accent-color, #4a6a1d);
    opacity: 0;
  }

  .product-rail-tabs__tablist--text .product-rail-tabs__tab[aria-selected='true'] {
    color: var(--color-foreground);
  }

  .product-rail-tabs__tablist--text .product-rail-tabs__tab[aria-selected='true']::after {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .product-rail-tabs__tab {
      font-size: 0.875rem;
    }
  }

  /* Rails */
  .product-rail-tabs__panel[hidden] {
    display: none;
  }

  .product-rail-tabs__slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  /* Desktop rail only: a literal 320px card (not the fluid --column-count formula), so it
     can bleed past the content column into the peeking fifth card. Scoped to the desktop
     rail specifically - the mobile rail keeps the base slideshow-slide `width: var(--slide-
     width, 100%)` fallback, driven by the inline --slide-width (mobile_card_size) percent. */
  .product-rail-tabs__rail-desktop .product-rail-tabs__slide {
    width: 320px;
  }

  .product-rail-tabs .slideshow-controls__progress {
    margin-top: 40px;
    padding-inline: 0;
    gap: 16px;
  }

  .product-rail-tabs__rail-mobile.force-full-width .slideshow-controls__progress {
    padding-inline: var(--util-page-margin-offset, var(--page-margin, 16px));
  }

  /* Desktop rail is also force-full-width (so the rail itself can bleed past the content
     column into the right-hand margin/viewport edge, per the Figma spec) - without this,
     the progress track (width: 100%, padding-inline: 0 from the rule above) spans the same
     full bleed as the rail instead of staying contained to the content column like
     collection-rail's and resource-list-carousel's progress tracks do. Re-apply the same
     page-margin inset used by the mobile rail above, on both edges - the desktop rail's
     right bleed is a rail-only effect (slideshow_gutters: 'start'), not a progress-track
     effect. */
  .product-rail-tabs__rail-desktop.force-full-width .slideshow-controls__progress {
    padding-inline: var(--util-page-margin-offset, var(--page-margin, 16px));
  }

  .product-rail-tabs .slideshow-controls__progress-track {
    height: 4px;
    background: var(--product-rail-tabs-track-color, var(--color-border));
  }

  .product-rail-tabs .slideshow-controls__progress-bar {
    background: var(--product-rail-tabs-accent-color, var(--color-foreground));
  }

  .product-rail-tabs .slideshow-controls__progress-arrows {
    display: none;
  }

  .product-rail-tabs__interactive--arrows .slideshow-controls__progress-arrows {
    display: flex;
  }

  /* Swatches: size/radius/gap + selected-state border, scoped to this section only */
  .product-rail-tabs .swatch {
    --swatch-width: 32px;
    --swatch-height: 32px;
    --color-border: var(--product-rail-tabs-track-color, #e0dcd2);
    border-width: 1px;
    /* radius follows the theme's Variant swatch setting (a circle at 32); forcing 6px here
       left the outer shell squarer than the colour fill inside it */
  }

  .product-rail-tabs .variant-option__button-label--has-swatch:has(:checked) {
    --focus-outline: 1.5px solid var(--product-rail-tabs-accent-color, #4a6a1d);

    outline: var(--focus-outline);
    outline-offset: 0;
  }

  .product-rail-tabs swatches-variant-picker-component overflow-list::part(list) {
    gap: 6px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_rail_tabs",
  "class": "ui-test-product-rail-tabs",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.bestsellers"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "t:text_defaults.shop_all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.tabs"
    },
    {
      "type": "paragraph",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "t:settings.label"
    },
    {
      "type": "collection",
      "id": "tab_1_collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "tab_1_max_products",
      "label": "t:settings.product_count",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "paragraph",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "t:settings.label"
    },
    {
      "type": "collection",
      "id": "tab_2_collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "tab_2_max_products",
      "label": "t:settings.product_count",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "paragraph",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "t:settings.label"
    },
    {
      "type": "collection",
      "id": "tab_3_collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "tab_3_max_products",
      "label": "t:settings.product_count",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "paragraph",
      "content": "Tab 4"
    },
    {
      "type": "text",
      "id": "tab_4_label",
      "label": "t:settings.label"
    },
    {
      "type": "collection",
      "id": "tab_4_collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "tab_4_max_products",
      "label": "t:settings.product_count",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "tabs_style",
      "label": "t:settings.tabs_style",
      "options": [
        {
          "value": "segmented",
          "label": "t:options.segmented"
        },
        {
          "value": "text",
          "label": "t:options.text"
        }
      ],
      "default": "segmented"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:settings.show_arrows",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_card_size",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
