            "role": "Hospital staff",
            "product": "Gaia Mary Jane",
            "verified": true
          }
        },
        "review_2": {
          "type": "review",
          "name": "t:names.review",
          "settings": {
            "quote": "<p>“First pair in years that didn’t rub my bunion. I ordered the wide and it was right the first time.”</p>",
            "name": "Real name",
            "role": "Role",
            "product": "Style",
            "verified": true
          }
        },
        "review_3": {
          "type": "review",
          "name": "t:names.review",
          "settings": {
            "quote": "<p>“Twelve hours on a ward floor and my feet still felt fine at the end of it.”</p>",
