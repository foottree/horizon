{% comment %}
  "Customer reviews" section (homepage section 06 in the client's Figma). Section-local
  `review` blocks (a Horizon section can't read theme-block settings - iterating
  `section.blocks` for `@theme` blocks gives back empty settings - so this mirrors
  sections/collection-rail.liquid: block settings live directly in this section's schema and
  are read straight off `block.settings` in a `for block in section.blocks` loop).

  Each review card is rendered once through snippets/review-card.liquid, its markup captured,
  then reused in two Horizon slideshows - a desktop one (cards sized to 1/`columns` of the row,
  scroll-snap carousel past the visible count) and a mobile one (single-card carousel at
  `mobile_card_size`% of the viewport) - only one of the pair is visible at a time
  (hidden--mobile / hidden--desktop), the same technique collection-rail uses for its own
  desktop/mobile split.
{% endcomment %}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

{%- liquid
  assign card_count = section.blocks.size
  assign desktop_slides = ''
  assign mobile_slides = ''
-%}

{%- for block in section.blocks -%}
  {%- capture card_html -%}
    {%- render 'review-card',
      image: block.settings.image,
      quote: block.settings.quote,
      name: block.settings.name,
      role: block.settings.role,
      product: block.settings.product,
      verified: block.settings.verified,
      verified_label: section.settings.verified_label,
      image_ratio: section.settings.image_ratio,
      image_fit: section.settings.image_fit,
      block_attributes: block.shopify_attributes
    -%}
  {%- endcapture -%}

  {%- capture desktop_slide -%}
    {%- render 'slideshow-slide', index: forloop.index0, children: card_html, class: 'review-cards__slide' -%}
  {%- endcapture -%}
  {%- assign desktop_slides = desktop_slides | append: desktop_slide -%}

  {%- capture mobile_slide -%}
    {%- render 'slideshow-slide', index: forloop.index0, children: card_html, class: 'review-cards__slide review-cards__mobile-slide' -%}
  {%- endcapture -%}
  {%- assign mobile_slides = mobile_slides | append: mobile_slide -%}
{%- endfor -%}

{%- liquid
  assign mobile_card_size = section.settings.mobile_card_size | default: 85
  assign columns = section.settings.columns | default: 3
  assign card_gap = section.settings.card_gap | default: 20

  assign desktop_style = '--slideshow-gap: ' | append: card_gap | append: 'px; --slide-width: calc((100% - (' | append: card_gap | append: 'px * (' | append: columns | append: ' - 1))) / ' | append: columns | append: ');'
  assign mobile_style = '--slideshow-gap: 16px; --slide-width: ' | append: mobile_card_size | append: '%;'

  # Carousel navigation - mirrors snippets/resource-list-carousel.liquid: dots win over
  # progress, arrows render on the slideshow itself (not inside the controls) and only
  # when icons_style isn't 'none'/'progress' and hide_arrows isn't checked.
  assign icons_style = section.settings.icons_style | default: 'progress'
  assign show_arrows = false
  if icons_style != 'none' and icons_style != 'progress' and section.settings.hide_arrows != true
    assign show_arrows = true
  endif

  assign desktop_has_controls = false
  if card_count > columns
    assign desktop_has_controls = true
  endif
  assign desktop_show_arrows = false
  if desktop_has_controls and show_arrows
    assign desktop_show_arrows = true
  endif

  assign mobile_has_controls = false
  if card_count > 1
    assign mobile_has_controls = true
  endif
  assign mobile_show_arrows = false
  if mobile_has_controls and show_arrows
    assign mobile_show_arrows = true
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    review-cards
    spacing-style
    {{ section.settings.css_class }}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --review-cards-eyebrow-color: {{ settings.color_palette.color1 }};
    --review-cards-accent-color: {{ settings.color_palette.color4 }};
    --review-cards-muted-color: {{ settings.color_palette.color8 }};
    --review-cards-line-color: {{ settings.color_palette.color3 }};
    --review-cards-chip-bg: {{ settings.color_palette.color2 }};
    --review-card-bg: {{ section.settings.card_background }};
    --review-card-radius: {{ section.settings.card_radius }}px;
    --review-card-media-bg: {{ settings.color_palette.color5 }};
    {% if section.settings.card_border %}
      --review-card-border: 1px solid {{ settings.color_palette.color3 }};
    {% endif %}
  "
  data-testid="review-cards"
>
  <div class="review-cards__header">
    <div class="review-cards__titles">
      {%- if section.settings.eyebrow != blank -%}
        <p class="review-cards__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="review-cards__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.show_rating -%}
      {%- capture score_content -%}
        <span class="review-cards__score-value">{{ section.settings.rating }}</span>
        <span class="review-cards__score-meta">
          {%- if section.settings.stars > 0 -%}
            <span
              class="review-cards__stars"
              aria-hidden="true"
            >{% for i in (1..section.settings.stars) %}&#9733;{% endfor %}</span>
          {%- endif -%}
          {%- if section.settings.rating_caption != blank -%}
            <span class="review-cards__caption">{{ section.settings.rating_caption }}</span>
          {%- endif -%}
        </span>
      {%- endcapture -%}
      {%- if section.settings.rating_link != blank -%}
        <a
          href="{{ section.settings.rating_link }}"
          class="review-cards__score"
        >{{ score_content }}</a>
      {%- else -%}
        <div class="review-cards__score">{{ score_content }}</div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="review-cards__desktop hidden--mobile">
    {%- capture desktop_controls -%}
      {%- if desktop_has_controls -%}
        {%- if section.settings.enable_dots -%}
          {%- render 'slideshow-controls',
            style: 'dots',
            autoplay: section.settings.autoplay,
            item_count: card_count,
            show_arrows: false,
            arrows_on_media: false,
            controls_on_media: false,
            pagination_position: 'center',
            class: 'review-cards__controls'
          -%}
        {%- elsif icons_style == 'progress' -%}
          {%- render 'slideshow-controls',
            style: 'progress',
            item_count: card_count,
            show_arrows: false,
            arrows_on_media: false,
            controls_on_media: false,
            pagination_position: 'center',
            class: 'review-cards__controls carousel-controls carousel-controls--progress'
          -%}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'slideshow',
      ref: 'reviewCardsDesktop',
      class: 'review-cards__slideshow',
      style: desktop_style,
      slides: desktop_slides,
      show_arrows: desktop_show_arrows,
      icon_style: icons_style,
      icon_shape: section.settings.icons_shape,
      autoplay: section.settings.autoplay,
      autoplay_speed: section.settings.autoplay_speed,
      auto_hide_controls: false,
      infinite: false,
      initial_slide: 0,
      slide_count: card_count,
      controls: desktop_controls
    -%}
  </div>

  <div
    class="review-cards__mobile hidden--desktop force-full-width"
    style="--gutter-slide-width: var(--util-page-margin-offset);"
  >
    {%- capture mobile_controls -%}
      {%- if mobile_has_controls -%}
        {%- if section.settings.enable_dots -%}
          {%- render 'slideshow-controls',
            style: 'dots',
            autoplay: section.settings.autoplay,
            item_count: card_count,
            show_arrows: false,
            arrows_on_media: false,
            controls_on_media: false,
            pagination_position: 'center',
            class: 'review-cards__controls'
          -%}
        {%- elsif icons_style == 'progress' -%}
          {%- render 'slideshow-controls',
            style: 'progress',
            item_count: card_count,
            show_arrows: false,
            arrows_on_media: false,
            controls_on_media: false,
            pagination_position: 'center',
            class: 'review-cards__controls carousel-controls carousel-controls--progress'
          -%}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'slideshow',
      ref: 'reviewCardsMobile',
      class: 'review-cards__slideshow review-cards__slideshow--mobile',
      style: mobile_style,
      slides: mobile_slides,
      show_arrows: mobile_show_arrows,
      icon_style: icons_style,
      icon_shape: section.settings.icons_shape,
      autoplay: section.settings.autoplay,
      autoplay_speed: section.settings.autoplay_speed,
      auto_hide_controls: false,
      infinite: false,
      initial_slide: 0,
      slide_count: card_count,
      slideshow_gutters: 'start end',
      controls: mobile_controls
    -%}
  </div>
</div>

{% stylesheet %}
  .review-cards__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-block-end: 32px;
  }

  .review-cards__titles {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .review-cards__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--review-cards-eyebrow-color, currentcolor);
  }

  .review-cards__heading {
    margin: 0;
    color: var(--color-foreground);
  }

  .review-cards__score {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .review-cards__score-value {
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 3rem;
    line-height: 1;
    color: var(--review-cards-accent-color, currentcolor);
  }

  .review-cards__score-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .review-cards__stars {
    font-size: 1.25rem;
    letter-spacing: 2px;
    line-height: 1;
    color: var(--review-cards-accent-color, currentcolor);
  }

  .review-cards__caption {
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--review-cards-muted-color, currentcolor);
  }

  @media screen and (max-width: 749px) {
    .review-cards__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  /* Desktop: each slide is one card, sized to 1/columns of the row - see --slide-width above. */
  .review-cards__slide {
    scroll-snap-align: start;
  }

  .review-cards__desktop .review-cards__slide {
    height: auto;
  }

  /* Mobile: every card is its own slide at mobile_card_size% (collection-rail's carousel pattern). */
  .review-cards .slideshow-controls__progress {
    margin-top: 32px;
    padding-inline: 0;
    gap: 16px;
  }

  .review-cards .slideshow-controls__progress-track {
    height: 4px;
    background: var(--review-cards-line-color, var(--color-border));
  }

  .review-cards .slideshow-controls__progress-bar {
    background: var(--review-cards-accent-color, var(--color-foreground));
  }

  .review-cards .slideshow-controls__progress-arrows {
    display: none;
  }

  .review-cards__mobile.force-full-width .slideshow-controls__progress {
    padding-inline: var(--util-page-margin-offset, var(--page-margin, 16px));
  }

  /* Carousel navigation: keep arrow overlays off the page edge on the full-width mobile
     carousel, the same way snippets/resource-list-carousel.liquid pads slideshow-arrows. */
  .review-cards__mobile.force-full-width slideshow-arrows {
    padding-inline: var(--util-page-margin-offset, var(--page-margin, 16px));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.review_cards",
  "class": "ui-test-review-cards",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "review",
      "name": "t:names.review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.photo"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:settings.quote",
          "default": "<p>“Quote goes here.”</p>"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:settings.name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:settings.role"
        },
        {
          "type": "text",
          "id": "product",
          "label": "t:settings.product_style"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "t:settings.show_verified_chip",
          "default": true
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "HEAR FROM OUR CUSTOMERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Why customers love Foot Tree"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:settings.show_rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating",
      "label": "t:settings.rating",
      "default": "5.0",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "range",
      "id": "stars",
      "label": "t:settings.stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "text",
      "id": "rating_caption",
      "label": "t:settings.rating_caption",
      "default": "60+ reviews",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "t:settings.rating_link",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "t:settings.gap",
      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "wide",
          "label": "t:options.wide"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:settings.image_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_card_size",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "t:settings.verified_label",
      "default": "Verified"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation"
    },
    {
      "type": "checkbox",
      "id": "enable_dots",
      "label": "Enable dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_arrows",
      "label": "Hide arrows",
      "default": false,
      "visible_if": "{{ section.settings.enable_dots == true }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.auto_rotate_slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:settings.speed",
      "min": 3,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ section.settings.autoplay == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "progress",
          "label": "t:options.progress_bar"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "progress"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "rectangle",
          "label": "Rectangle"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:content.card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.card_background",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "card_border",
      "label": "t:settings.card_border",
      "default": true
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:settings.card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS class",
      "info": "optional"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_padding",
      "label": "Custom Mobile Padding",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile-padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "mobile-padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "mobile-padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    },
    {
