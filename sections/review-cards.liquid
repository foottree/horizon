      "id": "mobile-padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_padding == true }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.review_cards",
      "category": "t:categories.storytelling",
      "settings": {},
      "blocks": {
        "review_1": {
          "type": "review",
          "name": "t:names.review",
          "settings": {
            "quote": "<p>“I have been wearing them almost 365 days of the year.”</p>",
