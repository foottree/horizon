{% comment %}
  Our Story cards: a centred header (optional mark, heading, lead) over a grid of white cards. One section
  builds three blocks of the page, set up in the template:

    What we stand for   2 columns, icon beside the text, no outline, on color2
    Who we make shoes for  4 columns, icon above, outlined, on color5
    Visit               2 columns, icon above, outlined, with buttons, on color5

  Each card is a 72px circle in color2 holding a 32px color4 glyph (the same badge the wholesale steps and
  sectors use - an uploaded Icon image takes over from the built-in icon), a title and a line of copy. A
  card can carry up to two buttons; each is hidden until it has both a label and a link.

  Below 990px the cards drop to two columns (one below 750px) and the icon always sits above the text, so
  a 72px badge never squeezes the copy.

  Type: .h2 on the heading (32px, 28px on mobile through the global step), .h5 on the card titles (an <h3>
  in the outline, the 18px rung), --font-paragraph--size for copy and the lead.
{% endcomment %}

{%- liquid
  case section.settings.background
    when 'soft'
      assign section_bg = settings.color_palette.color2
    when 'white'
      assign section_bg = settings.color_palette.background
    else
      assign section_bg = settings.color_palette.color5
  endcase
-%}

<div class="section-background" style="background-color: {{ section_bg }};"></div>

<div
  class="
    section section--narrow story-cards spacing-style
    story-cards--cols-{{ section.settings.columns }}
    story-cards--{{ section.settings.layout }}
    {% if section.settings.outline %}story-cards--outlined{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --sc-ink: {{ settings.color_palette.foreground }};
    --sc-soft: {{ settings.color_palette.color8 }};
    --sc-accent: {{ settings.color_palette.color4 }};
    --sc-badge: {{ settings.color_palette.color2 }};
    --sc-card: {{ settings.color_palette.background }};
    --sc-line: {{ settings.color_palette.color3 }};
    --sc-pad: {{ section.settings.card_padding }}px;
    --sc-header-width: {{ section.settings.header_width }}px;
  "
  data-testid="story-cards"
>
  <div class="story-cards__inner">
    {%- if section.settings.show_mark or section.settings.heading != blank or section.settings.lead != blank -%}
      <div class="story-cards__header">
        {%- if section.settings.show_mark -%}
          {%- render 'story-mark', class_name: 'story-cards__mark' -%}
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 story-cards__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="story-cards__lead">{{ section.settings.lead }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="story-cards__grid">
      {%- for block in section.blocks -%}
        <li class="story-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.icon != 'none' -%}
            <span class="story-card__badge" aria-hidden="true">
              {%- render 'icon-or-image',
                icon: block.settings.icon,
                image_upload: block.settings.image,
                width: 32,
                class_name: 'story-card__icon'
              -%}
            </span>
          {%- endif -%}

          <div class="story-card__body">
            {%- if block.settings.title != blank -%}
              <h3 class="h5 story-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="story-card__text">{{ block.settings.text }}</p>
            {%- endif -%}

            {%- capture actions_html -%}
              {%- render 'story-button',
                label: block.settings.button_1_label,
                url: block.settings.button_1_link,
                variant: 'solid'
              -%}
              {%- render 'story-button',
                label: block.settings.button_2_label,
                url: block.settings.button_2_link,
                variant: 'outline'
              -%}
            {%- endcapture -%}
            {%- if actions_html != blank -%}
              <div class="story-card__actions">{{ actions_html }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .story-cards__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .story-cards__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: var(--sc-header-width);
    margin-inline: auto;
    text-align: center;
  }

  .story-cards__mark {
    width: 40px;
    height: auto;
    color: var(--sc-accent);
  }

  /* .h2 / .h5 paint with `color: var(--color)`, so the colour goes in through --color. The scale's h2
     line height is 1, which crowds a heading that wraps on a phone; doubled class to beat .h2.h2. */
  .story-cards__title.story-cards__title {
    --color: var(--sc-ink);

    margin: 0;
    line-height: 1.2;
    text-wrap: balance;
  }

  .story-cards__lead {
    margin: 0;
    font-size: var(--font-paragraph--size);
    line-height: var(--line-height--body-loose);
    color: var(--sc-soft);
  }

  .story-cards__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: min(var(--sc-pad), 24px);
    border-radius: 8px;
    background: var(--sc-card);
  }

  .story-cards--outlined .story-card {
    box-shadow: inset 0 0 0 1px var(--sc-line);
  }

  .story-card__badge {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--sc-badge);
  }

  .story-card__icon {
    display: block;
    width: 32px;
    height: 32px;
    color: var(--sc-accent);
    object-fit: contain;
  }

  .story-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .story-card__title {
    --color: var(--sc-ink);

    margin: 0;
  }

  .story-card__text {
    margin: 0;
    font-size: var(--font-paragraph--size);
    line-height: var(--line-height--body-loose);
    color: var(--sc-soft);
  }

  /* Pushed to the foot of the card so the buttons line up across a row of cards of different heights. */
  .story-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-block-start: auto;
    padding-block-start: 12px;
  }

  @media screen and (max-width: 749px) {
    .story-cards__inner {
      gap: 32px;
    }

    .story-card__actions {
      flex-direction: column;
    }

    .story-card__actions .story-button {
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) {
    .story-cards__inner {
      gap: 56px;
    }

    .story-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .story-card {
      padding: var(--sc-pad);
    }
  }

  @media screen and (min-width: 990px) {
    .story-cards--cols-3 .story-cards__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .story-cards--cols-4 .story-cards__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .story-cards--beside .story-card {
      flex-direction: row;
      align-items: flex-start;
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story cards",
  "class": "section-story-cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Show the Foot Tree mark above the heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for long days on your feet"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "What goes into every pair — whether you buy one for yourself or outfit a whole team."
    },
    {
      "type": "range",
      "id": "header_width",
      "label": "Header width",
      "min": 600,
      "max": 1000,
      "step": 4,
      "unit": "px",
      "default": 760
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Icon position",
      "options": [
        { "value": "beside", "label": "Beside the text" },
        { "value": "above", "label": "Above the text" }
      ],
      "default": "above",
      "info": "On tablet and mobile the icon is always above the text."
    },
    {
      "type": "checkbox",
      "id": "outline",
      "label": "Outline the cards",
      "default": true
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "background",
      "label": "Section background",
      "options": [
        { "value": "soft", "label": "Soft green" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_padding",
      "label": "Custom mobile padding",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile-padding-block-start",
      "label": "Mobile top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "mobile-padding-block-end",
      "label": "Mobile bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.custom_mobile_padding }}"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 12,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "check_box", "label": "Check box" },
            { "value": "return", "label": "Return" },
            { "value": "heart", "label": "Heart" },
            { "value": "plane", "label": "Plane" },
            { "value": "truck", "label": "Truck" },
            { "value": "serving_dish", "label": "Serving dish" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "box", "label": "Box" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "lock", "label": "Lock" },
            { "value": "shoe", "label": "Shoe" },
            { "value": "star", "label": "Star" },
            { "value": "silhouette", "label": "Silhouette" }
          ],
          "default": "ruler"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A line or two about it."
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "First button label"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "First button link",
          "info": "A button is hidden until it has both a label and a link."
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Second button label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Second button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
