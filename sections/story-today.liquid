{% comment %}
  Our Story "Today" block (Figma "03 Today - stats"): a text column on the left - year chip, section heading,
  three paragraphs - with a 2 x 2 grid of stat tiles under it, and a tall portrait photo on the right.

  The stats are blocks so the client can edit them. The Figma build notes clear exactly four numbers (since
  1974, 1,000,000+ pairs, 80+ corporate clients, 5.0 from 60 Google reviews); the section holds up to four
  and the defaults are those four.

  The photo is an optional image picker. Empty, it renders nothing on the live site and the text column
  takes the row (see snippets/story-media.liquid); the theme editor shows a grey tile with the brief.

  Type: .h2 on the heading (32px; 28px on mobile through the global --font-h2--size step), .h4 on the stat
  numbers (24px), --font-size--sm for stat labels and the caption, --font-size--2xs for the chip.
{% endcomment %}

<div class="section-background" style="background-color: {{ settings.color_palette.background }};"></div>

<div
  class="section section--narrow story-today spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --sd-ink: {{ settings.color_palette.foreground }};
    --sd-soft: {{ settings.color_palette.color8 }};
    --sd-accent: {{ settings.color_palette.color4 }};
    --sd-chip: {{ settings.color_palette.color2 }};
    --sd-tile: {{ settings.color_palette.color2 }};
  "
  data-testid="story-today"
>
  {%- capture media_html -%}
    {%- render 'story-media',
      image: section.settings.image,
      layout: 'tall',
      brief: section.settings.brief,
      caption: section.settings.caption,
      alt: section.settings.heading
    -%}
  {%- endcapture -%}
  {%- assign has_media = false -%}
  {%- if media_html != blank -%}
    {%- assign has_media = true -%}
  {%- endif -%}

  <div class="story-today__row{% unless has_media %} story-today__row--text-only{% endunless %}">
    <div class="story-today__text">
      {%- if section.settings.chip != blank -%}
        <span class="story-today__chip">{{ section.settings.chip }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2 story-today__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="story-today__body">
        {%- if section.settings.paragraph_1 != blank -%}
          <p>{{ section.settings.paragraph_1 }}</p>
        {%- endif -%}
        {%- if section.settings.paragraph_2 != blank -%}
          <p>{{ section.settings.paragraph_2 }}</p>
        {%- endif -%}
        {%- if section.settings.paragraph_3 != blank -%}
          <p class="story-today__kicker">{{ section.settings.paragraph_3 }}</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="story-stats">
          {%- for block in section.blocks -%}
            <li class="story-stat" {{ block.shopify_attributes }}>
              {%- if block.settings.number != blank -%}
                <p class="h4 story-stat__number">{{ block.settings.number }}</p>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <p class="story-stat__label">{{ block.settings.label }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if has_media -%}
      <div class="story-today__media">{{ media_html }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .story-today__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 40px;
  }

  .story-today__text,
  .story-today__media {
    min-width: 0;
  }

  .story-today__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .story-today__row--text-only .story-today__text {
    max-width: 720px;
  }

  .story-today__chip {
    display: inline-flex;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--sd-chip);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--2xs);
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: var(--sd-accent);
  }

  /* .h2 / .h4 paint with `color: var(--color)`, so the colour goes in through --color. The scale's h2
     line height is 1, which crowds this two-line heading; doubled class to beat .h2.h2. */
  .story-today__title.story-today__title {
    --color: var(--sd-ink);

    margin: 0;
    line-height: 1.2;
    text-wrap: balance;
  }

  .story-today__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: var(--font-paragraph--size);
    line-height: var(--line-height--body-loose);
    color: var(--sd-soft);
  }

  .story-today__body p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  /* The closing line of the copy is the one that lands, so it drops the muted tone. */
  .story-today__body .story-today__kicker {
    color: var(--sd-ink);
  }

  .story-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .story-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 24px 28px;
    border-radius: 8px;
    background: var(--sd-tile);
  }

  .story-stat__number {
    --color: var(--sd-accent);

    margin: 0;
  }

  .story-stat__label {
    margin: 0;
    font-size: var(--font-size--sm);
    line-height: 1.4;
    color: var(--sd-soft);
  }

  @media screen and (max-width: 749px) {
    .story-stats {
      gap: 12px;
    }

    .story-stat {
      padding: 20px 16px;
    }
  }

  @media screen and (min-width: 750px) {
    .story-today__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(48px, 8.34vw, 120px);
    }

    .story-today__row--text-only {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story today",
  "class": "section-story-today",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "chip",
      "label": "Year chip",
      "default": "Today — City Square"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed in Singapore. Hand made in-house. Fitted in person."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First paragraph",
      "default": "Every material comes from suppliers we trust, and every pair is checked at each stage of making — not just at the end."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second paragraph",
      "default": "Our work shoes are slip-resistant and supportive for long shifts. Across the range you'll find wide fits, half sizes and extended sizes, with styles that make room for bunions."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Closing paragraph",
      "info": "Set in the darker text color instead of the muted one.",
      "default": "That's why we still own every step, from the first sketch to the fitting."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Leave empty and the text takes the full row on the live site. A grey tile showing the brief appears in the theme editor."
    },
    {
      "type": "text",
      "id": "brief",
      "label": "Photo brief (editor only)",
      "info": "What photo belongs here. Shown on the grey tile in the theme editor, never on the live site."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Sits under the photo and is hidden with it."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_padding",
      "label": "Custom mobile padding",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile-padding-block-start",
      "label": "Mobile top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "mobile-padding-block-end",
      "label": "Mobile bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.custom_mobile_padding }}"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1,000,000+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "pairs made and fitted"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story today",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
