{% comment %}
  Client logo strip (For Organisations page, "Logo banner strip" in the client's Figma): a
  continuously scrolling row of logo + label pairs.

  Why not sections/marquee.liquid: it only accepts text / icon / logo / divider theme blocks, and none
  of those can pair a picture with a caption. This reuses the same <marquee-component> element and
  assets/marquee.js (which only needs the three ref attributes below, it clones the items to fill the
  row and sets --marquee-speed), with its own markup and classes.

  The client's logos were uploaded on 2026-10-14 as transparent PNGs trimmed to the ink. Every logo
  renders at the same height (the "Logo height" setting) and its width follows its own shape. A new
  logo must be prepared the same way (trimmed, transparent background) or it will look smaller or
  boxed on the tinted band. A block with no logo still shows a placehold.co rectangle instead of the
  theme's grey placeholder.

  Motion: the animation only exists inside prefers-reduced-motion: no-preference, so a visitor who
  asks for less motion gets a still row. Hovering slows it to a stop (marquee.js).

  No hairline above or below the strip. The Figma frame does carry a 1px #e0dcd2 top and bottom
  stroke and this was built from it, but the client asked for the rules to come off — the tinted
  band already separates itself from the white sections either side. A deliberate departure from
  the mockup, so do not "restore" it on the next Figma pass.
{% endcomment %}

<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<marquee-component
  class="wholesale-logos"
  style="
    --wholesale-logos-bg: {{ settings.color_palette.color2 }};
    --wholesale-logos-pad: {{ section.settings.padding_block }}px;
    --marquee-direction: {{ section.settings.movement_direction }};
    --wholesale-logos-height: {{ section.settings.logo_height }}px;
    --wholesale-logos-pad-mobile: {{ section.settings.padding_block_mobile }}px;
    --wholesale-logos-height-mobile: {{ section.settings.logo_height_mobile }}px;
    --marquee-gap: {{ section.settings.logo_gap }}px;
  "
  data-speed-factor="25"
  data-movement-direction="{{ section.settings.movement_direction }}"
  data-testid="wholesale-logos"
>
  <div
    class="wholesale-logos__wrapper"
    ref="wrapper"
  >
    <div
      class="wholesale-logos__content"
      ref="content"
    >
      <div
        class="wholesale-logos__items"
        ref="marqueeItems[]"
      >
        {%- for block in section.blocks -%}
          <div class="wholesale-logos__item" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {%- liquid
                assign logo = block.settings.logo
                assign logo_height = section.settings.logo_height
                assign height_2x = logo_height | times: 2
                assign height_3x = logo_height | times: 3
                assign logo_width = logo.aspect_ratio | times: logo_height | round
              -%}
              <img
                class="wholesale-logos__logo"
                src="{{ logo | image_url: height: height_2x }}"
                srcset="{{ logo | image_url: height: logo_height }} 1x, {{ logo | image_url: height: height_2x }} 2x, {{ logo | image_url: height: height_3x }} 3x"
                width="{{ logo_width }}"
                height="{{ logo_height }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
              >
            {%- else -%}
              {%- assign placeholder_width = section.settings.logo_height | times: 160 | divided_by: 48.0 | round -%}
              {% # theme-check-disable RemoteAsset %}
              <img
                class="wholesale-logos__logo"
                src="https://placehold.co/160x48?text=Client"
                width="{{ placeholder_width }}"
                height="{{ section.settings.logo_height }}"
                alt=""
                loading="lazy"
              >
              {% # theme-check-enable RemoteAsset %}
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="wholesale-logos__label">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</marquee-component>

{% stylesheet %}
  .wholesale-logos {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-block: var(--wholesale-logos-pad);
    background: var(--wholesale-logos-bg);
  }

  .wholesale-logos__wrapper {
    display: flex;
    gap: var(--marquee-gap, 64px);
    width: fit-content;
    white-space: nowrap;
  }

  .wholesale-logos__content {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap, 64px);
  }

  .wholesale-logos__items {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap, 64px);
    align-items: center;
  }

  .wholesale-logos__item {
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--wholesale-logos-height, 48px);
  }

  .wholesale-logos__logo {
    display: block;
    flex: none;
    height: var(--wholesale-logos-height, 48px);
    width: auto;
    max-width: none;
  }

  .wholesale-logos__label {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-paragraph--size);
    line-height: 1.2;
    color: var(--color-foreground);
  }

  /* Smaller strip on phones. The mobile variables are separate from the desktop ones because the
     desktop values arrive as inline custom properties, which a stylesheet cannot override. */
  @media screen and (max-width: 749px) {
    .wholesale-logos {
      padding-block: var(--wholesale-logos-pad-mobile, var(--wholesale-logos-pad));
    }

    .wholesale-logos__item,
    .wholesale-logos__logo {
      height: var(--wholesale-logos-height-mobile, var(--wholesale-logos-height, 48px));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .wholesale-logos:not([data-disabled]) .wholesale-logos__wrapper {
      animation: wholesale-logos-motion var(--marquee-speed, 40s) linear infinite var(--marquee-direction);
    }
  }

  @keyframes wholesale-logos-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo marquee",
  "class": "section-wholesale-logos",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "movement_direction",
      "label": "Direction",
      "options": [
        { "value": "normal", "label": "Right to left" },
        { "value": "reverse", "label": "Left to right" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Padding top and bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height on phones",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_block_mobile",
      "label": "Padding top and bottom on phones",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Use a PNG with a transparent background, trimmed to the logo's edges, so every logo sits at the same height."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Healthcare"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo marquee",
      "blocks": [
        { "type": "client", "settings": { "label": "Healthcare" } },
        { "type": "client", "settings": { "label": "F&B" } },
        { "type": "client", "settings": { "label": "Aviation" } },
        { "type": "client", "settings": { "label": "Transport" } },
        { "type": "client", "settings": { "label": "Security" } },
        { "type": "client", "settings": { "label": "Corporate" } }
      ]
    }
  ]
}
{% endschema %}
