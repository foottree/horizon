{% comment %}
  Request a quotation (For Organisations page, "05 Request a quotation" in the client's Figma): a
  two-column band on a tinted background. Left, a Shopify contact form; right, a white contact card.

  Salvaged from the earlier wholesale-page branch and cut back to the Figma. That version had eight
  fields, a sector and volume select, a fitting-day checkbox, a legal line and an "already an account
  customer?" card; none of those are in the design, and the build notes are explicit that a buyer
  researching suppliers at 11pm will not create an account to ask a price. It is a plain guest
  contact form (Shopify's own form tag): no login, no account.

  The Figma's third field is named "Order quantity *" but labelled "Organisation" with the placeholder
  "e.g. 50 pairs". It is built as drawn, and its label, placeholder and required flag are settings so
  the client can fix whichever half is wrong without a code change.

  Field names matter. contact[email] and contact[body] are the two Shopify treats specially (the
  reply-to address and the message). Every other field arrives in the notification email under its
  own name, so the names below are part of the data. Every field is written back on a rejected
  submission (the earlier version dropped most of them).

  The base.css rule input:not([type='checkbox'], [type='radio']) has specificity (0,1,1), which beats
  a plain class, so the control classes are doubled (.wq-control.wq-control) to win.

  The section id (setting `anchor_id`, default "quotation") is what buttons elsewhere on the page link
  to; the form carries the same id plus "-form", which is where Shopify returns the shopper after
  posting.

  Type: .h2 for the heading, --font-size--2xs for eyebrows, --font-size--sm for field labels,
  --font-paragraph--size for inputs and copy, the .h5 size on the contact card title (in the
  heading face, which .h5 does not supply — see the rule for why).
{% endcomment %}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'quotation' | handleize
  assign form_dom_id = anchor | append: '-form'
-%}

<div
  class="section-background"
  style="background-color: {{ settings.color_palette.color5 }};"
></div>

<div
  id="{{ anchor }}"
  class="section section--narrow wholesale-quote spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --wq-heading: {{ settings.color_palette.foreground }};
    --wq-accent: {{ settings.color_palette.color4 }};
    --wq-tint: {{ settings.color_palette.color5 }};
    --wq-line: {{ settings.color_palette.color3 }};
    --wq-soft: {{ settings.color_palette.color8 }};
    --wq-ink: {{ settings.color_palette.foreground }};
    --wq-paper: {{ settings.color_palette.background }};
  "
  data-testid="wholesale-quote"
>
  <div class="wholesale-quote__layout">
    <div class="wholesale-quote__main">
      <div class="wholesale-quote__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="wholesale-quote__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 wholesale-quote__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- form 'contact', id: form_dom_id, class: 'wq-form' -%}
        {%- if form.posted_successfully? -%}
          <div
            class="wq-message wq-message--success"
            role="status"
            tabindex="-1"
          >
            {{ section.settings.success_message }}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div
            class="wq-message wq-message--error"
            role="alert"
            tabindex="-1"
          >
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="wq-row">
          <div class="wq-field">
            <label class="wq-label" for="{{ form_dom_id }}-name">Name *</label>
            <input
              class="wq-control wq-control"
              type="text"
              id="{{ form_dom_id }}-name"
              name="contact[name]"
              autocomplete="name"
              placeholder="e.g. Jane Smith"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              required
            >
          </div>
          <div class="wq-field">
            <label class="wq-label" for="{{ form_dom_id }}-email">Email *</label>
            <input
              class="wq-control wq-control"
              type="email"
              id="{{ form_dom_id }}-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              placeholder="jane@organisation.com.sg"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required
            >
          </div>
        </div>

        <div class="wq-field">
          <label class="wq-label" for="{{ form_dom_id }}-organisation">
            {{- section.settings.organisation_label }}
            {% if section.settings.organisation_required %}*{% endif -%}
          </label>
          <input
            class="wq-control wq-control"
            type="text"
            id="{{ form_dom_id }}-organisation"
            name="contact[Organisation]"
            autocomplete="organization"
            placeholder="{{ section.settings.organisation_placeholder | escape }}"
            value="{{ form['Organisation'] }}"
            {% if section.settings.organisation_required %}
              required
            {% endif %}
          >
        </div>

        <div class="wq-field">
          <label class="wq-label" for="{{ form_dom_id }}-body">{{ section.settings.message_label }}</label>
          <textarea
            class="wq-control wq-control wq-control--textarea"
            id="{{ form_dom_id }}-body"
            name="contact[body]"
            rows="3"
            placeholder="{{ section.settings.message_placeholder | escape }}"
          >{{ form.body }}</textarea>
        </div>

        {%- comment -%}
          Shopify's contact form delivers every contact[...] field into the same inbox as the
          general enquiry form, with nothing to say which page it came from. These two hidden
          fields label it, so a wholesale quotation is sortable in the inbox and in any rule or
          helpdesk integration rather than being told apart by eye. The label is editable because
          the team's own wording for this is theirs to choose.
        {%- endcomment -%}
        <input type="hidden" name="contact[Enquiry type]" value="{{ section.settings.enquiry_tag | escape }}">
        <input type="hidden" name="contact[Submitted from]" value="{{ request.origin }}{{ request.path }}">

        <div class="wq-actions">
          <button type="submit" class="button wq-submit">{{ section.settings.submit_label }}</button>
        </div>
      {%- endform -%}
    </div>

    <aside class="wholesale-quote__rail">
      <div class="wq-card">
        {%- if section.settings.contact_heading != blank -%}
          <h3 class="h4 wq-card__title">{{ section.settings.contact_heading }}</h3>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <div class="wq-contact" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="wq-contact__label">{{ block.settings.label }}</p>
            {%- endif -%}
            {%- if block.settings.value != blank -%}
              <div class="wq-contact__value">{{ block.settings.value }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </aside>
  </div>
</div>

{% stylesheet %}
  .wholesale-quote {
    scroll-margin-block-start: 96px;
  }

  .wholesale-quote__layout {
    display: grid;
    grid-template-columns: minmax(0, 756fr) minmax(0, 420fr);
    align-items: start;
    column-gap: 64px;
  }

  .wholesale-quote__main {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  .wholesale-quote__intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .wholesale-quote__eyebrow,
  .wq-contact__label {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--2xs);
    line-height: 1.3;
    letter-spacing: 0.12em;
    color: var(--wq-accent);
  }

  /* Only the section eyebrow is forced uppercase. The card's labels are typed as drawn —
     the Figma has "Contact:" in sentence case and "EMAIL" in caps — so the block setting is
     the literal label and CSS must not override it. */
  .wholesale-quote__eyebrow {
    text-transform: uppercase;
  }

  /* .h2 / .h5 paint with `color: var(--color)`, so the colour goes in through --color. */
  .wholesale-quote__title {
    --color: var(--wq-heading);

    margin: 0;
  }

  .wq-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .wq-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .wq-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .wq-label {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-normal);
    color: var(--wq-ink);
  }

  /* doubled classes: base.css input:not([type='checkbox'], [type='radio']) is (0,1,1) */
  .wq-control.wq-control {
    box-sizing: border-box;
    width: 100%;
    min-height: 56px;
    padding: 0 20px;
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph--size);
    line-height: var(--line-height--body-loose);
    color: var(--wq-ink);
    background-color: var(--wq-paper);
    border: 1px solid var(--wq-line);
    border-radius: 8px;
    box-shadow: none;
  }

  .wq-control.wq-control::placeholder {
    color: var(--wq-soft);
    opacity: 1;
  }

  /* base.css hides the placeholder once a field has a value; keep that behaviour */
  .wq-control.wq-control:not(:placeholder-shown)::placeholder {
    opacity: 0;
  }

  .wq-control.wq-control:focus-visible {
    outline: 2px solid var(--wq-accent);
    outline-offset: 2px;
  }

  .wq-control--textarea.wq-control--textarea {
    min-height: 150px;
    padding-block: 16px;
    resize: vertical;
  }

  /* No bespoke height. This was min-height: 64px, straight off the Figma's "Button / Send
     request 200x64", which made it the tallest button on the site - 64 against the theme's
     58 and the 50 the homepage hero blocks are set to. The height now comes from
     --button-padding-block like every other button, so it matches the "Request a quotation"
     button further up this same page. Width stays at the Figma's 200. */
  .wq-submit.wq-submit {
    min-width: 200px;
    font-size: var(--font-paragraph--size);
  }

  .wq-message {
    padding: 16px 20px;
    font-size: var(--font-paragraph--size);
    line-height: var(--line-height--body-normal);
    border-radius: 8px;
  }

  .wq-message--success {
    color: var(--wq-heading);
    background: var(--wq-paper);
    border: 1px solid var(--wq-accent);
  }

  .wq-message--error {
    color: var(--color-error);
    background: var(--wq-paper);
    border: 1px solid var(--color-error);
  }

  .wholesale-quote__rail {
    min-width: 0;
  }

  .wq-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
    background: var(--wq-paper);
    border: 1px solid var(--wq-line);
    border-radius: 8px;
  }

  /* An <h3> on the h4 preset: 24px on the heading face, the same rung as the step titles and the
     technology feature titles, so every item-level heading on this page is one size. It was .h5,
     which is 18px and - because theme settings put h5 alone on the subheading face while h1-h4
     are on the heading face - also rendered in Plus Jakarta Sans. Moving to h4 fixes the size and
     the face together, so no font-family override is needed here any more. */
  .wq-card .wq-card__title {
    --color: var(--wq-heading);

    margin: 0;
  }

  .wq-contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wq-contact__value {
    font-size: var(--font-paragraph--size);
    line-height: var(--line-height--body-loose);
    color: var(--wq-ink);
    overflow-wrap: anywhere;
  }

  .wq-contact__value > * {
    margin: 0;
  }

  .wq-contact__value a {
    color: inherit;
    text-decoration: none;
  }

  .wq-contact__value a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .wholesale-quote__layout {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .wq-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .wq-card {
      padding: 24px;
    }

    .wq-submit.wq-submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wholesale quotation form",
  "class": "section-wholesale-quote",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "info": "Buttons elsewhere on the page link to #this-id.",
      "default": "quotation"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Request a quotation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell us about your needs"
    },
    {
      "type": "text",
      "id": "organisation_label",
      "label": "Third field label",
      "info": "The mockup names this field \"Order quantity\" but labels it \"Organisation\" with a pairs placeholder. Change whichever half is wrong.",
      "default": "Organisation"
    },
    {
      "type": "text",
      "id": "organisation_placeholder",
      "label": "Third field placeholder",
      "default": "e.g. 50 pairs"
    },
    {
      "type": "checkbox",
      "id": "organisation_required",
      "label": "Third field is required",
      "default": false
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "What are your corporate needs:"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Do you have any uniform specification?"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Button label",
      "default": "Send request"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. We have your request and will reply within one working day."
    },
    {
      "type": "header",
      "content": "Contact card"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Rather just talk to someone?"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "enquiry_tag",
      "label": "Enquiry label",
      "info": "Sent with the form as a hidden field so these land tagged in the inbox, apart from general enquiries.",
      "default": "Wholesale quotation"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact detail",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Contact:"
        },
        {
          "type": "richtext",
          "id": "value",
          "label": "Value",
          "default": "<p>+65 6744 7824 Mon - Fri (9am-6pm)</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale quotation form",
      "blocks": [
        {
          "type": "contact",
          "settings": {
            "label": "Contact:",
            "value": "<p>+65 6744 7824 Mon - Fri (9am-6pm)</p>"
          }
        },
        {
          "type": "contact",
          "settings": {
            "label": "Email",
            "value": "<p>peapesfw@foottree.com</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
