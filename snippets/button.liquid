{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
    {%- if block_settings.show_arrow %} button--with-arrow{% endif -%}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {{ block_settings.label }}
  {%- if block_settings.show_arrow -%}
    <span class="svg-wrapper" aria-hidden="true">
      {{- 'icon-arrow.svg' | inline_asset_content -}}
    </span>
  {%- endif -%}
</a>

{% stylesheet %}
  .button--with-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .button--with-arrow .svg-wrapper {
    flex-shrink: 0;
    color: currentcolor;
  }
{% endstylesheet %}
