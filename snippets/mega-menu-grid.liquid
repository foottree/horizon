{%- doc -%}
  Renders the "grid" mega menu panel style (left groups + shop-all pill, center columns,
  right promo tiles), matched to the sg.anothersole.com Women/Men reference (see the CSS block
  "Header mega menu: tabbed & grid" in assets/custom.css for the measured spec this implements).

  LEFT = the panel's two group menus (each menu's title is the uppercase group heading, its
  links are the group's links) plus the shop-all pill button. CENTER = one column per 2nd-level
  link that has children (uppercase heading = its title, linking to its own URL; rows = its
  3rd-level links with a 40px circular thumbnail from the linked collection's featured image,
  or a placeholder circle; the last row is "All <2nd-level title>"). RIGHT = the panel's nested
  `_mega-menu-promo` tiles, in block order — pre-rendered by the caller
  (`_mega-menu-panel.liquid`, via its own `{% content_for 'blocks' %}`, the only place those
  tiles' own `block.settings` are resolved) and passed in as `promo_tiles`.

  Typography for the group/column headings and links reuses the stock `.mega-menu__link` /
  `.mega-menu__link--parent` classes (already themed via submenu-font-styles.liquid) so this
  respects the header block's own typography settings; only layout and the new pieces
  (thumbnails, the "All X" row, the CTA pill, promo tiles) are added.

  @param {object} link - The top-level menu link being rendered (e.g. "Women").
  @param {object} panel - The matched `_mega-menu-panel` block (style == 'grid').
  @param {string} promo_tiles - Pre-rendered HTML for the right column's promo tiles.

  @example
  {% render 'mega-menu-grid', link: link, panel: block, promo_tiles: promo_tiles %}
{%- enddoc -%}

<div
  class="ft-grid"
  {{ panel.shopify_attributes }}
>
  <nav
    class="ft-grid__left"
    aria-label="{{ link.title }}"
  >
    {% if panel.settings.group_1_menu != blank %}
      <div class="ft-grid__left-group">
        <p class="mega-menu__link mega-menu__link--parent ft-grid__group-heading">
          {{- panel.settings.group_1_menu.title -}}
        </p>
        <ul class="ft-grid__sublist list-unstyled">
          {% for child in panel.settings.group_1_menu.links %}
            <li>
              <a
                href="{{ child.url }}"
                class="mega-menu__link"
              >
                {{- child.title -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
    {% if panel.settings.group_2_menu != blank %}
      <div class="ft-grid__left-group">
        <p class="mega-menu__link mega-menu__link--parent ft-grid__group-heading">
          {{- panel.settings.group_2_menu.title -}}
        </p>
        <ul class="ft-grid__sublist list-unstyled">
          {% for child in panel.settings.group_2_menu.links %}
            <li>
              <a
                href="{{ child.url }}"
                class="mega-menu__link"
              >
                {{- child.title -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
    {% if panel.settings.shop_all_url != blank %}
      <a
        href="{{ panel.settings.shop_all_url }}"
        class="button ft-grid__cta"
      >
        {{- panel.settings.shop_all_label -}}
      </a>
    {% endif %}
  </nav>
  <div class="ft-grid__center">
    <ul class="ft-grid__columns list-unstyled">
      {% for column_link in link.links %}
        {% if column_link.links == blank %}
          {% continue %}
        {% endif %}
        <li class="ft-grid__column">
          <a
            href="{{ column_link.url }}"
            class="mega-menu__link mega-menu__link--parent ft-grid__column-heading"
          >
            <span class="mega-menu__link-title">{{- column_link.title -}}</span>
          </a>
          <ul class="list-unstyled">
            {% for row in column_link.links %}
              <li>
                <a
                  href="{{ row.url }}"
                  class="mega-menu__link ft-grid__row"
                >
                  <span class="ft-grid__thumb">
                    {% if row.object.featured_image %}
                      {{
                        row.object.featured_image
                        | image_url: width: 80
                        | image_tag:
                          loading: 'lazy',
                          widths: '40, 80',
                          sizes: '40px',
                          class: 'ft-grid__thumb-img',
                          alt: row.title
                      }}
                    {% endif %}
                  </span>
                  <span class="mega-menu__link-title">{{- row.title -}}</span>
                </a>
              </li>
            {% endfor %}
            <li>
              <a
                href="{{ column_link.url }}"
                class="ft-grid__all-link"
              >
                {{- 'actions.all_category' | t: title: column_link.title -}}
              </a>
            </li>
          </ul>
        </li>
      {% endfor %}
    </ul>
  </div>
  <div class="ft-grid__right">
    {{ promo_tiles }}
  </div>
</div>
