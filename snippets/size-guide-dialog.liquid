{%- doc -%}
  The "Size Guide" link that sits on the size option's own label row in the variant picker,
  and the dialog it opens.

  Rendered in three parts because a <legend> may only contain phrasing content: the trigger
  goes inside the legend (a <button> is phrasing content, a <dialog> is not), and the dialog
  goes after the fieldset. The dialog component must be a SIBLING of the fieldset, never its
  wrapper: Component.refs skips anything inside a nested component, so a wrapping
  <dialog-component> hid ref="fieldsets[]" from <variant-picker>, which then never tracked
  data-current-checked / data-previous-checked, and the stock wrap-around rule left the last
  size's own pill translated off the pill. The trigger reaches the dialog by id instead.

  @param {string} part - 'open', 'trigger' or 'close'
  @param {object} settings - The variant picker block's settings
  @param {string} id - The block id, so two pickers on one page get distinct heading ids

  @example
  {% render 'size-guide-dialog', part: 'open', settings: block_settings, id: block.id %}
{%- enddoc -%}

{%- liquid
  assign size_guide_label = settings.size_guide_text | default: 'Size Guide'
  assign size_guide_heading_id = 'size-guide-heading-' | append: id
  assign size_guide_dialog_id = 'size-guide-' | append: id
-%}

{%- case part -%}
  {%- when 'open' -%}
    <script
      src="{{ 'dialog.js' | asset_url }}"
      type="module"
    ></script>

    {% render 'dialog-styles' %}
  {%- when 'trigger' -%}
    <button
      type="button"
      on:click="#{{ size_guide_dialog_id }}/showDialog"
      class="button button-unstyled size-guide__trigger"
    >
      {{- size_guide_label -}}
      <span class="svg-wrapper size-guide__arrow">
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </span>
    </button>
  {%- when 'close' -%}
    <dialog-component
      id="{{ size_guide_dialog_id }}"
      class="size-guide"
    >
      <dialog
        ref="dialog"
        class="size-guide__content dialog-modal color-custom-popover"
        scroll-lock
        aria-labelledby="{{ size_guide_heading_id }}"
      >
        <h2
          id="{{ size_guide_heading_id }}"
          class="visually-hidden"
        >
          {{ size_guide_label }}
        </h2>
        <div class="size-guide__inner">
          {{ settings.size_guide_content }}
        </div>
        <button
          ref="closeButton"
          on:click="/closeDialog"
          class="button button-unstyled close-button size-guide__close"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </dialog>
    </dialog-component>
{%- endcase -%}
