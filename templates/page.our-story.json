{
  "sections": {
    "breadcrumb": {
      "type": "breadcrumb",
      "settings": {
        "menu": "main-menu",
        "background_color": "{{ settings.color_palette.color5 }}"
      }
    },
    "hero": {
      "type": "story-hero",
      "blocks": {
        "stat_1": {
          "type": "stat",
          "settings": {
            "number": "1,000,000+",
            "label": "pairs made and fitted"
          }
        },
        "stat_2": {
          "type": "stat",
          "settings": {
            "number": "80+",
            "label": "corporate clients"
          }
        },
        "stat_3": {
          "type": "stat",
          "settings": {
            "number": "Est. 1974",
            "label": "a Singapore brand"
          }
        }
      },
      "block_order": [
        "stat_1",
        "stat_2",
        "stat_3"
      ],
      "settings": {
        "layout": "split",
        "image": "shopify://shop_images/our-story-hero-placeholder.png",
        "min_height": 440,
        "eyebrow": "BUILT FOR PROFESSIONALS, NOW EVERYONE",
        "heading": "Three generations.\n50 years of craftsmanship.",
        "text": "",
        "alignment": "left",
        "watermark_color": "#6c814f",
        "padding-block-start": 50,
        "padding-block-end": 50,
        "custom_mobile_padding": true,
        "mobile-padding-block-start": 91,
        "mobile-padding-block-end": 91
      }
    },
    "timeline": {
      "type": "story-timeline",
      "blocks": {
        "row_1974": {
          "type": "row",
          "settings": {
            "chip": "1974",
            "heading": "Where it all began",
            "body": "<p>Our founder grew up in his father’s shoe factory in Singapore, learning the trade at the bench from the time he was a boy.</p><p>It taught him the idea every shoe is still built on: comfort is not one size fits all.</p>",
            "layout": "single",
            "image": "shopify://shop_images/our-story-1974-placeholder.png",
            "caption": "",
            "media_shape": "landscape"
          }
        },
        "row_1981": {
          "type": "row",
          "settings": {
            "chip": "1981",
            "heading": "Our founder took over the business",
            "body": "<p>After taking over the business, our founder decided to shift production overseas in order to stay more price competitive. He was adamant in maintaining our manufacturing capabilities to ensure quality control and proper workmanship.</p>",
            "layout": "pair",
            "image": "shopify://shop_images/our-story-1981-a-placeholder.png",
            "caption": "",
            "image_2": "shopify://shop_images/our-story-1981-b-placeholder.png"
          }
        },
        "row_1989": {
          "type": "row",
          "settings": {
            "chip": "1989",
            "heading": "Uniform shoes for frontline workers",
            "body": "<p>Nurses, cabin crew and bus captains spend all day on their feet. We began making uniform footwear for the organisations they work for — and learned exactly what a long shift asks of a shoe.</p>",
            "layout": "pair",
            "image": "shopify://shop_images/our-story-1989-a-placeholder.png",
            "caption": "",
            "image_2": "shopify://shop_images/our-story-1989-b-placeholder.png"
          }
        },
        "row_2000": {
          "type": "row",
          "settings": {
            "chip": "2000",
            "heading": "Our headquarters at Paya Lebar",
            "body": "<p>We built our headquarters in Paya Lebar and grew our team. From just the founder and his wife, they grew to a dedicated team of 10, with a dedicated delivery fleet to service customers from all over Singapore.</p>",
            "layout": "single",
            "image": "shopify://shop_images/our-story-2000-placeholder.png",
            "caption": "",
            "media_shape": "landscape"
          }
        },
        "row_today": {
          "type": "row",
          "settings": {
            "chip": "Today — City Square",
            "heading": "Our First Flagship Store",
            "body": "<p>We opened our store at City Square Mall so anyone could walk in and be fitted properly — both feet measured, length and width, by people who fit feet every day.</p>",
            "layout": "single",
            "image": "shopify://shop_images/our-story-today-placeholder.png",
            "caption": "",
            "media_shape": "portrait"
          }
        }
      },
      "block_order": [
        "row_1974",
        "row_1981",
        "row_1989",
        "row_2000",
        "row_today"
      ],
      "settings": {
        "padding-block-start": 50,
        "padding-block-end": 50,
        "custom_mobile_padding": true,
        "mobile-padding-block-start": 91,
        "mobile-padding-block-end": 91
      }
    },
    "letter": {
      "type": "story-letter",
      "settings": {
        "image": "shopify://shop_images/heritage-archive.jpg",
        "focus_x": 58,
        "eyebrow": "SINCE 1974",
        "paragraph_1": "For over fifty years, we’ve made shoes for frontline staff. Now we’d love to fit you.",
        "opening_size": "heading",
        "paragraph_2": "",
        "signoff": "Built for professionals. Now everyone.",
        "desktop_height": 500
      }
    },
    "visit": {
      "type": "story-cards",
      "blocks": {
        "visit_store": {
          "type": "card",
          "settings": {
            "icon": "map_pin",
            "title": "Foot Tree at City Square Mall",
            "text": "180 Kitchener Road, #03-15\nCity Square Mall, Singapore 208539\nOpen daily, 11am – 9pm",
            "button_1_label": "Get directions",
            "button_1_link": "https://www.google.com/maps/search/?api=1&query=180+Kitchener+Road+%2303-15+City+Square+Mall+Singapore+208539"
          }
        },
        "visit_online": {
          "type": "card",
          "settings": {
            "icon": "box",
            "title": "Shop online",
            "text": "Free local delivery over S$100, in 2–4 working days.\nBought the wrong size? Exchange it free in store within 30 days.",
            "button_1_label": "Shop women",
            "button_1_link": "/collections/women",
            "button_2_label": "Shop men",
            "button_2_link": "/collections/men"
          }
        }
      },
      "block_order": [
        "visit_store",
        "visit_online"
      ],
      "settings": {
        "show_mark": false,
        "heading": "Come and be fitted",
        "lead": "Visit our store at City Square, or shop online with free local delivery over S$100.",
        "header_width": 900,
        "columns": "2",
        "layout": "above",
        "outline": true,
        "card_padding": 48,
        "background": "cream",
        "padding-block-start": 50,
        "padding-block-end": 50,
        "custom_mobile_padding": true,
        "mobile-padding-block-start": 91,
        "mobile-padding-block-end": 91
      }
    }
  },
  "order": [
    "breadcrumb",
    "hero",
    "timeline",
    "letter",
    "visit"
  ]
}
