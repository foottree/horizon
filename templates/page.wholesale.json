    "fo_steps": {
      "type": "wholesale-steps",
      "settings": {
        "heading": "How Foot Tree wholesale works",
        "subheading": "Four steps, and only one of them needs your team to stop what they are doing.",
        "background_color": "{{ settings.color_palette.color5 }}",
        "padding-block-start": 80,
        "padding-block-end": 80
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "step_visual": "spec_sheet",
            "title": "Tell us what you need",
            "text": "Roles, headcount, the floor they work on, and any uniform specification you have to meet."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "step_visual": "fitting",
            "title": "We fit on site",
            "text": "We bring samples in the full width run and measure every person — about two minutes each. No one guesses a size."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "step_visual": "invoice",
            "title": "One quotation, one delivery",
            "text": "A single quotation against your PO, GST invoice, delivered boxed and labelled by name."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "step_visual": "shipping",
            "title": "Reorders in days",
            "text": "We hold your size run. A new starter or a replacement pair ships without another fitting."
          }
        }
      },
