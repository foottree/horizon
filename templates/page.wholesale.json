    "fo_faq": {
      "type": "wholesale-faq",
      "settings": {
        "heading": "Bulk Order FAQ",
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 80,
        "padding-block-end": 80
      },
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Is there a minimum order?",
            "answer": "<p>No minimum on a first order. On-site fitting days and account pricing start to make sense from about [XX] pairs — tell us your headcount and we will say plainly whether a programme is worth it for you.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Stock styles: [X] working days. A size run already held on your account: next working day. A specification build or a special colour: [X] weeks. All confirmed on the quotation.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Can you invoice against a purchase order?",
            "answer": "<p>Yes. Quotation, PO, delivery order and GST invoice, with agreed payment terms on account. Prices are quoted GST-inclusive unless you ask otherwise.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "What if someone is in the wrong size afterwards?",
            "answer": "<p>Free exchange within 30 days, unworn and boxed — the same guarantee as retail. A fitting day removes most of this before it happens.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Do individual staff get a discount?",
            "answer": "<p>[TO CONFIRM — the healthcare and service discount and its percentage still need signing off before this can go live.]</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "Can staff order for themselves?",
            "answer": "<p>Yes. Once your account is open, staff log in and order at your contract price, delivered to home or to site. You keep visibility of what has been ordered against the programme.</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4",
        "faq_5",
        "faq_6"
      ]
    },
